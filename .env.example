# ==============================================================================
# Pharmora – Production-Ready Authentication & Security Configuration
# ==============================================================================

# Environment (development | production)
APP_ENV=development

# Cryptographic Server Secret (Used for Flask Sessions and HMAC-SHA256 OTP Hashing)
SECRET_KEY=pharmora_super_secret_cryptographic_key_2026

# OTP Verification Policies
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN=60

# Transactional Email Gateway Provider (smtp | resend | console)
EMAIL_PROVIDER=smtp
EMAIL_FROM=Pharmora Security <noreply@pharmora.health>

# SMTP Configuration (AWS SES / SendGrid / Mailgun / Postmark / Mailtrap)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password

# Alternative: Resend Transactional Email API
RESEND_API_KEY=

# SMS Gateway Configuration (MSG91 - India DLT Compliant)
SMS_PROVIDER=msg91
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_TEMPLATE_ID=your_msg91_template_id
MSG91_SENDER_ID=PHRMOR
